        <mxCell id="pkg_ai" value="5. Phân hệ Trí tuệ Nhân tạo (NLP Phân loại Tự động &amp; Phát hiện Bất thường)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
