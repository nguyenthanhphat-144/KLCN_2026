        <mxCell id="uc_5_1" value="UC5.1: Hợp nhất 4 trường văn bản&#xa;(Tiêu đề + Tóm tắt + Từ khóa + Tác giả)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="pkg_ai">
