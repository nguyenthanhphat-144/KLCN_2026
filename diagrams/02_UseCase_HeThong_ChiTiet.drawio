        <mxCell id="uc_5_4" value="UC5.4: Phân loại chuyên sâu bằng&#xa;Deep Learning (Fine-tuned PhoBERT)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontColor=#000000;" vertex="1" parent="pkg_ai">
