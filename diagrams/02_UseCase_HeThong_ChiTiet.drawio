        <mxCell id="uc_5_5" value="UC5.5: Tính điểm tin cậy (%) &amp;&#xa;Gán mã màu (Xanh &gt;80%, Vàng, Đỏ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontColor=#000000;" vertex="1" parent="pkg_ai">
