        <!-- Title -->
        <mxCell id="title" value="SƠ ĐỒ THỰC THỂ LIÊN KẾT (ERD) &amp; THIẾT KẾ CƠ SỞ DỮ LIỆU VẬT LÝ MICROSOFT SQL SERVER&#xa;HỆ THỐNG HỖ TRỢ QUẢN LÝ HỒ SƠ KH&amp;CN (REVISION 2026 - TÍCH HỢP BÀI BÁO &amp; ĐỀ TÀI NCKH)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="1100" height="50" as="geometry" />
        </mxCell>

        <!-- Table 1: NguoiDung -->
        <mxCell id="tbl_nguoidung" value="NguoiDung (Bảng Người Dùng)&#xa;───────────────────────────────────────&#xa;[PK] maNguoiDung : INTEGER&#xa;     hoTen       : NVARCHAR(150) NOT NULL&#xa;     email       : VARCHAR(150) NOT NULL UNIQUE&#xa;     matKhau     : VARCHAR(255) NOT NULL&#xa;     vaiTro      : VARCHAR(20) NOT NULL&#xa;     donViCongTac: NVARCHAR(200)&#xa;     hocHamHocVi : NVARCHAR(50)&#xa;     trangThai   : INT DEFAULT 1&#xa;     ngayTao     : DATETIME" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="420" height="195" as="geometry" />
        </mxCell>

        <!-- Table 2: LinhVuc -->
        <mxCell id="tbl_linhvuc" value="LinhVuc (Bảng Danh Mục Lĩnh Vực)&#xa;───────────────────────────────────────&#xa;[PK] maLinhVuc   : INTEGER&#xa;     maCode      : VARCHAR(30) NOT NULL UNIQUE&#xa;     tenLinhVuc  : NVARCHAR(200) NOT NULL&#xa;     moTa        : NVARCHAR(MAX)&#xa;     tuKhoaDacTrung : NVARCHAR(MAX)&#xa;     trangThai   : INT DEFAULT 1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="320" width="420" height="155" as="geometry" />
        </mxCell>

        <!-- Table 3: LoaiCongTrinh -->
        <mxCell id="tbl_loai" value="LoaiCongTrinh (Bảng Loại Công Trình)&#xa;───────────────────────────────────────&#xa;[PK] maLoai      : INTEGER&#xa;     maCodeLoai  : VARCHAR(30) NOT NULL UNIQUE&#xa;     tenLoai     : NVARCHAR(200) NOT NULL&#xa;     nhomCongTrinh: NVARCHAR(100) (Bài báo / Đề tài)&#xa;     trangThai   : INT DEFAULT 1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="510" width="420" height="145" as="geometry" />
        </mxCell>

        <!-- Table 4: TapChiHopLe -->
        <mxCell id="tbl_tapchi" value="TapChiHopLe (Bảng Danh Mục Tạp Chí)&#xa;───────────────────────────────────────&#xa;[PK] maTapChi    : INTEGER&#xa;     tenTapChi   : NVARCHAR(250) NOT NULL&#xa;     chiSoISSN   : VARCHAR(30)&#xa;     xepHang     : NVARCHAR(100)&#xa;[FK] maLinhVuc   : INTEGER&#xa;     uyTin       : INT DEFAULT 1&#xa;     trangThai   : INT DEFAULT 1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="690" width="420" height="170" as="geometry" />
        </mxCell>

        <!-- CENTER TABLE: HoSoKHCN (Chuẩn hóa 12 Trường Đầu vào) -->
        <mxCell id="tbl_hoso" value="HoSoKHCN (Bảng Hồ Sơ KH&amp;CN Trung Tâm - 12 Trường Chuẩn)&#xa;═════════════════════════════════════════════════════════&#xa;[PK] maHoSo          : VARCHAR(30)&#xa;     tieuDe          : NVARCHAR(500) NOT NULL&#xa;     tomTat          : NVARCHAR(MAX) NOT NULL&#xa;     tuKhoa          : NVARCHAR(300) NOT NULL&#xa;     donViChuTri     : NVARCHAR(200) NOT NULL&#xa;     namCongBo       : INT NOT NULL&#xa;     kyBaoCao        : NVARCHAR(100) NOT NULL&#xa;[FK] maNguoiNop      : INTEGER -&gt; NguoiDung&#xa;[FK] maLinhVuc       : INTEGER -&gt; LinhVuc (Lĩnh vực đăng ký)&#xa;[FK] maLoai          : INTEGER -&gt; LoaiCongTrinh (Loại hình &amp; Loại CT)&#xa;─────────────────────────────────────────────────────────&#xa;[Trường Đặc Thù: Bài Báo Khoa Học (Mục 10 &amp; 11)]&#xa;[FK] maTapChi        : INTEGER -&gt; TapChiHopLe (Tên tạp chí/Hội thảo)&#xa;     chiMucTapChi    : NVARCHAR(100) (Chỉ mục tạp chí)&#xa;─────────────────────────────────────────────────────────&#xa;[Trường Đặc Thù: Đề Tài NCKH (Mục 12)]&#xa;     sanPhamDuKien   : NVARCHAR(MAX) (Sản phẩm dự kiến)&#xa;─────────────────────────────────────────────────────────&#xa;[Trường Quản Lý Quy Trình &amp; Tích Hợp AI]&#xa;     trangThai       : NVARCHAR(50) (CHECK: Chờ xét duyệt |&#xa;                       Đang xét duyệt | Đã duyệt | Từ chối |&#xa;                       Yêu cầu bổ sung)&#xa;     fileDinhKem     : NVARCHAR(255)&#xa;     isDeleted       : INT DEFAULT 0&#xa;     vanBanDaTachTu  : NVARCHAR(MAX) (PyVi NLP)&#xa;[FK] maLinhVucAI     : INTEGER -&gt; LinhVuc (PhoBERT)&#xa;     doTinCayAI      : FLOAT (0.0 -&gt; 100.0 %)&#xa;[FK] maLinhVucSVM    : INTEGER -&gt; LinhVuc (Baseline SVM)&#xa;     doTinCaySVM     : FLOAT&#xa;     diemBatThuong   : FLOAT (Isolation Forest &amp; Autoencoder)&#xa;     coCanhBao       : INT DEFAULT 0&#xa;     chiTietCanhBao  : NVARCHAR(MAX)&#xa;     ngayNop         : DATETIME&#xa;     ngayCapNhat     : DATETIME" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontFamily=Courier New;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="510" y="90" width="510" height="720" as="geometry" />
        </mxCell>

        <!-- Table 6: LichSuXetDuyet -->
        <mxCell id="tbl_lichsu" value="LichSuXetDuyet (Nhật Ký Thẩm Định Bất Biến)&#xa;───────────────────────────────────────&#xa;[PK] maLichSu    : INTEGER&#xa;[FK] maHoSo      : VARCHAR(30) -&gt; HoSoKHCN&#xa;[FK] maCanBo     : INTEGER -&gt; NguoiDung&#xa;     trangThaiCu : NVARCHAR(50)&#xa;     trangThaiMoi: NVARCHAR(50) NOT NULL&#xa;     yKienDanhGia: NVARCHAR(MAX) NOT NULL&#xa;     thoiGian    : DATETIME" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
