        <!-- Table 7: PhanHoiAI (Feedback Loop) -->
        <mxCell id="tbl_feedback" value="PhanHoiAI (Feedback Loop Cải Tiến AI)&#xa;───────────────────────────────────────&#xa;[PK] maPhanHoi      : INTEGER&#xa;[FK] maHoSo         : VARCHAR(30) -&gt; HoSoKHCN&#xa;[FK] maCanBo        : INTEGER -&gt; NguoiDung&#xa;[FK] maLinhVucAI    : INTEGER -&gt; LinhVuc&#xa;[FK] maLinhVucThucTe: INTEGER -&gt; LinhVuc&#xa;     doTinCayLucDo  : FLOAT&#xa;     ketQuaKhop     : INT (1=Đúng, 0=Điều chỉnh)&#xa;     vanBanHuanLuyen: NVARCHAR(MAX)&#xa;     thoiGian       : DATETIME" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
