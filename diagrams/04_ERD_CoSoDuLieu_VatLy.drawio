        <!-- Table 8: ThucNghiemMoHinhAI -->
        <mxCell id="tbl_metrics" value="ThucNghiemMoHinhAI (Đánh Giá Mô Hình AI)&#xa;───────────────────────────────────────&#xa;[PK] maThucNghiem     : INTEGER&#xa;     tenMoHinh        : NVARCHAR(150)&#xa;     precisionScore   : FLOAT&#xa;     recallScore      : FLOAT&#xa;     f1Score          : FLOAT&#xa;     thoiGianPhanHoiMs: FLOAT&#xa;     soMauKiemThu     : INT&#xa;     ngayDanhGia      : DATETIME" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Courier New;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
