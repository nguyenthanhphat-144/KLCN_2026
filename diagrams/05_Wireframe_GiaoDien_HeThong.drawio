        <!-- ==================== SCREEN 3: GIAO DIỆN XÉT DUYỆT ƯU TIÊN & AI PANEL ==================== -->
        <mxCell id="scr3_frame" value="MÀN HÌNH 3: GIAO DIỆN THẨM ĐỊNH TÍNH HỢP LỆ VÀ QUẢN LÝ QUY TRÌNH 5 BƯỚC (REVISION 2026)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#F8FAFC;strokeColor=#6B46C1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#44337A;" vertex="1" parent="1">
