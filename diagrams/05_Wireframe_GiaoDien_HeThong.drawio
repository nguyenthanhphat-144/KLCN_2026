        <!-- ==================== SCREEN 3: GIAO DIỆN XÉT DUYỆT ƯU TIÊN & AI PANEL ==================== -->
        <mxCell id="scr3_frame" value="MÀN HÌNH 3: GIAO DIỆN THẨM ĐỊNH &amp; XÉT DUYỆT ƯU TIÊN TÍCH HỢP AI PHÂN LOẠI &amp; PHÁT HIỆN BẤT THƯỜNG (TUẦN 6 - MỤC 2D)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#F8FAFC;strokeColor=#6B46C1;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#44337A;" vertex="1" parent="1">
          <mxGeometry x="40" y="635" width="1560" height="570" as="geometry" />
        </mxCell>

        <!-- Left Pane: Thông tin hồ sơ chi tiết -->
        <mxCell id="s3_left" value="📄 THÔNG TIN CHI TIẾT HỒ SƠ CẦN THẨM ĐỊNH: [HS-2026-001]&#xa;─────────────────────────────────────────────────────────────────────────────&#xa;• Tiêu đề: Ứng dụng mô hình ngôn ngữ tiền huấn luyện PhoBERT trong phân loại tự động hồ sơ KH&amp;CN&#xa;• Tác giả: TS. Nguyễn Minh Quân, ThS. Phạm Hoàng Nam (Khoa Công nghệ Thông tin)&#xa;• Loại công trình: Bài báo khoa học trên tạp chí quốc tế Scopus (Q1)&#xa;• Tạp chí công bố: Engineering Applications of Artificial Intelligence (ISSN: 0952-1976) - [✔ Thuộc DM Hợp lệ]&#xa;• Lĩnh vực do Tác giả khai báo: [ Công nghệ thông tin và Truyền thông ]&#xa;• Từ khóa: PhoBERT, TF-IDF, Support Vector Machine, Phân loại văn bản tiếng Việt, Quản lý KH&amp;CN&#xa;• Tóm tắt (Abstract):&#xa;  Nghiên cứu này trình bày quy trình tiền xử lý văn bản khoa học tiếng Việt sử dụng thư viện tách từ PyVi&#xa;  kết hợp với mô hình học sâu PhoBERT (vinai/phobert-base) được fine-tune nhằm tự động gán nhãn chuyên ngành...&#xa;• Tệp minh chứng đính kèm: [📥 Toàn_văn_bài_báo_HS2026001.pdf]   [📥 Minh_chứng_Scopus_Indexing.pdf]&#xa;&#xa;📜 LỊCH SỬ XÉT DUYỆT (Bảng LichSuXetDuyet):&#xa;  - 10/10/2026 08:30 | Hệ thống | Khởi tạo hồ sơ -&gt; Trạng thái: 'Chờ xét duyệt'&#xa;  - 11/10/2026 09:15 | ThS. Lê Thanh Tùng | Chuyển sang 'Đang xét duyệt' - Đã kiểm tra minh chứng hợp lệ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E0;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="scr3_frame">
          <mxGeometry x="15" y="45" width="760" height="505" as="geometry" />
        </mxCell>

        <!-- Right Top Pane: Khung Gợi ý phân loại từ AI (Chức năng 5 - 2d) -->
        <mxCell id="s3_ai_box" value="🤖 KHUNG GỢI Ý PHÂN LOẠI TỰ ĐỘNG TỪ AI &amp; FEEDBACK LOOP (CHỨC NĂNG 5)&#xa;─────────────────────────────────────────────────────────────────────────────&#xa;• Chuỗi sau tách từ (PyVi): ung_dung mo_hinh ngon_ngu tien_huan_luyen phobert trong phan_loai tu_dong...&#xa;• Nhãn lĩnh vực AI dự đoán (PhoBERT):  [ Công nghệ thông tin và Truyền thông ]&#xa;• Nhãn dự đoán đối chiếu (TF-IDF+SVM): [ Công nghệ thông tin và Truyền thông ]&#xa;• Mức độ tin cậy (Confidence Score):   [██████████████████████████░░] 94.6%&#xa;• Mã màu trực quan tự động:&#xa;   [🟢 XANH LÁ (&gt; 80%): Độ tin cậy Rất cao]   (Vàng: 50% - 80% | Đỏ: &lt; 50% Cảnh báo xem xét kỹ)&#xa;&#xa;🔄 CƠ CHẾ PHẢN HỒI CỦA CÁN BỘ (FEEDBACK LOOP PHỤC VỤ FINE-TUNING):&#xa;   [ ✔ Xác nhận nhãn AI chính xác ]    HOẶC   Điều chỉnh nhãn thực tế: [ Chọn lại danh mục chuẩn ▼ ] [Lưu điều chỉnh]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;strokeWidth=2;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="scr3_frame">
          <mxGeometry x="795" y="45" width="745" height="215" as="geometry" />
        </mxCell>

        <!-- Right Middle Pane: Khung Cảnh báo bất thường NetworkX + Isolation Forest -->
        <mxCell id="s3_anom_box" value="🕸️ KHUNG PHÂN TÍCH ĐỒ THỊ NETWORKX &amp; PHÁT HIỆN BẤT THƯỜNG (ISOLATION FOREST)&#xa;─────────────────────────────────────────────────────────────────────────────&#xa;• Điểm bất thường (Anomaly Score): 0.12 (Ngưỡng an toàn &lt; 0.50) -&gt; Trạng thái: [🟢 HỒ SƠ BÌNH THƯỜNG]&#xa;• Kiểm tra trùng lặp nội dung (Cosine Similarity): Tương đồng cao nhất 14.2% với HS-2025-089 (An toàn)&#xa;• Kiểm tra liên kết Đồ thị Tác giả - Lĩnh vực (NetworkX): Tác giả có 8 công trình cùng nút 'CNTT &amp; TT'&#xa;• Kiểm tra danh mục Tạp chí: Hợp lệ (Thuộc danh mục ISI/Scopus chuẩn của Nhà trường)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="scr3_frame">
          <mxGeometry x="795" y="275" width="745" height="125" as="geometry" />
        </mxCell>

        <!-- Right Bottom Pane: Quyết định Xét duyệt của Cán bộ -->
        <mxCell id="s3_decision_box" value="⚖️ QUYẾT ĐỊNH THẨM ĐỊNH &amp; GHI NHẬN LỊCH SỬ XÉT DUYỆT (CHỨC NĂNG 3)&#xa;─────────────────────────────────────────────────────────────────────────────&#xa;• Ý kiến đánh giá của Cán bộ xét duyệt (*):&#xa;  [ Hồ sơ đầy đủ minh chứng, bài báo đăng trên tạp chí Q1 uy tín, đúng lĩnh vực chuyên ngành AI gợi ý. ]&#xa;&#xa;  [ ✅ PHÊ DUYỆT HỒ SƠ (Đã duyệt) ]     [ ⏳ ĐANG XÉT DUYỆT ]     [ ❌ TỪ CHỐI HỒ SƠ ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D69E2E;strokeWidth=2;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="scr3_frame">
          <mxGeometry x="795" y="415" width="745" height="135" as="geometry" />
        </mxCell>

